#!/bin/sh
# Build, lint and tests run here and nowhere else (never in CI).
# Runs the Makefile targets 'build', 'lint' and 'test' that exist, in that order.
[ -f Makefile ] || [ -f makefile ] || [ -f GNUmakefile ] || exit 0

has_target() { make -n "$1" >/dev/null 2>&1; }

for t in build lint test; do
  if has_target "$t"; then
    echo "pre-push: make $t"
    make "$t" || { echo "pre-push: 'make $t' failed; push aborted." >&2; exit 1; }
  fi
done
exit 0
